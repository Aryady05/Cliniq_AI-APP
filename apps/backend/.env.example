APP_NAME=Cliniq AI Backend
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_USER=cliniq
POSTGRES_PASSWORD=cliniq
POSTGRES_DB=cliniq_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cliniq:cliniq@localhost:5432/cliniq_ai

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

GEMINI_API_KEY=replace-with-your-key
# Gemini model stays configurable so it can be upgraded without code changes.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

MSG91_AUTH_KEY=replace-with-msg91-key
MSG91_SENDER_ID=CLINIQ

DEFAULT_REGION=IN
PDF_OUTPUT_DIR=generated_reports
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
